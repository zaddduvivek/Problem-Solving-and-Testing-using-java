class Solution {
    public int[] sortArrayByParity(int[] nums) {
        int[] ans = new int[nums.length];
        int index = 0;

        // Add even numbers first
        for (int num : nums) {
            if (num % 2 == 0) {
                ans[index++] = num;
            }
        }

        // Add odd numbers next
        for (int num : nums) {
            if (num % 2 != 0) {
                ans[index++] = num;
            }
        }

        return ans;
    }
}
