import java.util.*;

public class Solution {
    static int[] maxSubarray(int[] arr) {
        int maxSubarray = arr[0], current = arr[0];
        int maxSubsequence = arr[0];
        for (int i = 1; i < arr.length; i++) {
            current = Math.max(arr[i], current + arr[i]);
            maxSubarray = Math.max(maxSubarray, current);
            if (arr[i] > 0) {
                if (maxSubsequence > 0) maxSubsequence += arr[i];
                else maxSubsequence = arr[i];
            } else {
                maxSubsequence = Math.max(maxSubsequence, arr[i]);
            }
        }
        return new int[]{maxSubarray, maxSubsequence};
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while (t-- > 0) {
            int n = sc.nextInt();
            int[] arr = new int[n];
            for (int i = 0; i < n; i++) arr[i] = sc.nextInt();
            int[] res = maxSubarray(arr);
            System.out.println(res[0] + " " + res[1]);
        }
    }
}
