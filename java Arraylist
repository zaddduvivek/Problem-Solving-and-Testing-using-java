import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Read the number of lines
        int n = scanner.nextInt();
        
        // Create a 2D ArrayList (ArrayList of ArrayLists)
        List<ArrayList<Integer>> lines = new ArrayList<>();
        
        for (int i = 0; i < n; i++) {
            int d = scanner.nextInt(); // Number of integers in this line
            ArrayList<Integer> row = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                row.add(scanner.nextInt());
            }
            lines.add(row);
        }
        
        // Read the number of queries
        int q = scanner.nextInt();
        
        for (int i = 0; i < q; i++) {
            int x = scanner.nextInt(); // 1-based line index
            int y = scanner.nextInt(); // 1-based position index
            
            // Convert 1-based indices to 0-based indices for Java ArrayList
            int lineIndex = x - 1;
            int posIndex = y - 1;
            
            // Check if the requested line exists
            if (lineIndex >= 0 && lineIndex < lines.size()) {
                ArrayList<Integer> row = lines.get(lineIndex);
                // Check if the requested position exists within that line
                if (posIndex >= 0 && posIndex < row.size()) {
                    System.out.println(row.get(posIndex));
                } else {
                    System.out.println("ERROR!");
                }
            } else {
                System.out.println("ERROR!");
            }
        }
        
        scanner.close();
    }
}
