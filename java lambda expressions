    // Returns a lambda expression to check if a number is odd
    public PerformOperation isOdd() {
        return n -> n % 2 != 0;
    }

    // Returns a lambda expression to check if a number is prime
    public PerformOperation isPrime() {
        return n -> {
            if (n < 2) return false;
            for (int i = 2; i * i <= n; i++) {
                if (n % i == 0) return false;
            }
            return true;
        };
    }

    // Returns a lambda expression to check if a number is a palindrome
    public PerformOperation isPalindrome() {
        return n -> {
            String str = String.valueOf(n);
            String rev = new StringBuilder(str).reverse().toString();
            return str.equals(rev);
        };
    }
}
